    "seed:avatar-parts": "tsx --env-file=.env.local scripts/seed-avatar-parts.mts",
    "worker": "node scripts/run-tsx.mjs --node-option=--conditions=react-server --env-file=.env.local scripts/worker.mts",
    "voice-agent": "node scripts/run-tsx.mjs --node-option=--conditions=react-server --env-file=.env.local scripts/voice-agent.mts dev",
