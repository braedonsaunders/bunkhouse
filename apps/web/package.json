  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "pretest": "pnpm test:desk-security",
    "test": "node scripts/run-tests.mjs",
    "test:product-ui": "node scripts/run-tsx.mjs --node-option=--import=./scripts/pin-test-env.mjs --node-option=--conditions=react-server scripts/product-ui.test.mts",
