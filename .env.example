# Application and first-boot owner
APP_URL=http://localhost:4810
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-first-boot-password

# PostgreSQL: the application role is RLS-bound; the super role must have BYPASSRLS.
BUNKHOUSE_DB_URL=postgresql://bunkhouse_app:password@localhost:5432/bunkhouse
BUNKHOUSE_SUPER_URL=postgresql://bunkhouse_super:password@localhost:5432/bunkhouse
BUNKHOUSE_REDIS_URL=redis://localhost:6379

# Secret sealing. Keep the same value on web, worker, and voice-agent.
APPKIT_SECRET=replace-with-at-least-32-random-characters

# S3-compatible files and workspaces
APPKIT_STORAGE_ENDPOINT=https://s3.example.com
APPKIT_STORAGE_ACCESS_KEY_ID=replace-me
APPKIT_STORAGE_SECRET_ACCESS_KEY=replace-me
APPKIT_STORAGE_BUCKET=bunkhouse
APPKIT_STORAGE_REGION=auto
APPKIT_STORAGE_FORCE_PATH_STYLE=false
BUNKHOUSE_AGENT_HOMES=.agent-homes

# Voice and meetings (the local docker compose uses devkey/secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The agent desk runner (deploy/desk-runner.compose.yaml). Leave both blank
# and the desk abilities fail closed — agents have no machine.
BUNKHOUSE_DESK_URL=
BUNKHOUSE_DESK_TOKEN=
# Desk-runner storage roots: golden base image + per-agent CoW overlays.
BUNKHOUSE_AGENT_DISKS=/data/agent-disks
# The governed company shared folder, mounted into every guest via virtio-fs.
BUNKHOUSE_SHARED_FOLDER=/data/shared

# Optional role/skill installation from private GitHub repositories.
BUNKHOUSE_GITHUB_TOKEN=

